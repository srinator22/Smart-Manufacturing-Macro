{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet format *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet stryker *)",
      "Bash(gitleaks git *)",
      "Bash(git-cliff *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-context.sh\""
          }
        ]
      }
    ]
  }
}
