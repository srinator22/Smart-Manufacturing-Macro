<Window x:Class="WmpToolsManager.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/WmpToolsManager.UI;component/Assets/check-updates-light-32.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="WMP Tools Manager" />
            <TextBlock Margin="0,6,0,0" Text="{Binding Summary}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Margin="0,0,8,0" FontWeight="SemiBold" Text="Installed" />
            <TextBlock Grid.Column="1" Margin="0,0,24,0" Text="{Binding InstalledVersionText}" />
            <TextBlock Grid.Column="2" Margin="0,0,8,0" FontWeight="SemiBold" Text="Latest" />
            <TextBlock Grid.Column="3" Text="{Binding LatestVersionText}" />
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,0,0,4" FontWeight="SemiBold" Text="Plugins in this release" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      ItemsSource="{Binding Plugins}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Plugin" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn Header="Maturity" Binding="{Binding Maturity}" Width="2*" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1"
                       Margin="0,12,0,4"
                       FontWeight="SemiBold"
                       Text="Release notes"
                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer Grid.Row="2"
                          MaxHeight="150"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NotesExcerpt}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontWeight="SemiBold" Foreground="Red" Text="Problems" />
            <ItemsControl MaxHeight="110" ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,2,0,0" Foreground="Red" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Separator Grid.Row="5" Margin="0,14,0,10" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />

            <Button Grid.Column="1"
                    Width="110"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    IsEnabled="{Binding CanCheck}"
                    Click="CheckAgain_Click"
                    Content="Check again" />

            <Button Grid.Column="2"
                    Width="170"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    IsDefault="True"
                    IsEnabled="{Binding CanDownload}"
                    Click="DownloadAndInstall_Click"
                    Content="Download and install" />

            <Button Grid.Column="3"
                    Width="170"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    IsEnabled="{Binding CanRollback}"
                    Click="Rollback_Click"
                    Content="Roll back to previous"
                    Visibility="{Binding IsRollbackVisible, Converter={StaticResource BoolToVisibility}}" />

            <Button Grid.Column="4"
                    Width="90"
                    Padding="8,4"
                    IsCancel="True"
                    Click="Close_Click"
                    Content="Close" />
        </Grid>
    </Grid>
</Window>
