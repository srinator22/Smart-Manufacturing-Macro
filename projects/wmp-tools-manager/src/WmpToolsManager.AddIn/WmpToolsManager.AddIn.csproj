<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(ProgramFiles)\Autodesk\Inventor 2027\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
    <ApplicationManifest>WmpToolsManager.AddIn.X.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(InventorInteropPath)')">
    <DefineConstants>$(DefineConstants);INVENTOR_INTEROP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WmpToolsManager.Application\WmpToolsManager.Application.csproj" />
    <ProjectReference Include="..\WmpToolsManager.Infrastructure\WmpToolsManager.Infrastructure.csproj" />
    <ProjectReference Include="..\WmpToolsManager.UI\WmpToolsManager.UI.csproj" />
    <ProjectReference Include="..\..\..\..\shared\WmpRibbon\WmpRibbon.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(InventorInteropPath)')">
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <EmbeddedResource Include="..\..\assets\tools-manager-16.png"
                      Link="Assets\tools-manager-16.png"
                      LogicalName="WmpToolsManager.AddIn.Assets.tools-manager-16.png" />
    <EmbeddedResource Include="..\..\assets\tools-manager-32.png"
                      Link="Assets\tools-manager-32.png"
                      LogicalName="WmpToolsManager.AddIn.Assets.tools-manager-32.png" />
    <!-- The ribbon tooltip states this plugin's maturity. Embedding the catalog entry ties that
         statement to the binary, so a shipped DLL cannot claim a maturity that its plugin.json no
         longer declares. -->
    <EmbeddedResource Include="..\..\plugin.json"
                      Link="plugin.json"
                      LogicalName="WmpToolsManager.AddIn.plugin.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
