<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(ProgramFiles)\Autodesk\Inventor 2027\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(InventorInteropPath)')">
    <DefineConstants>$(DefineConstants);INVENTOR_INTEROP</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FileNamingManager.LiveSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FileNamingManager.Application\FileNamingManager.Application.csproj" />
    <ProjectReference Include="..\..\src\FileNamingManager.Core\FileNamingManager.Core.csproj" />
    <ProjectReference Include="..\..\src\FileNamingManager.Infrastructure\FileNamingManager.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\FileNamingManager.InventorAdapter\FileNamingManager.InventorAdapter.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(InventorInteropPath)')">
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <!-- Private=true here, unlike the AddIn: a standalone exe is not hosted by Inventor.exe,
           so the interop assembly must sit beside the exe to be resolvable at runtime. -->
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
