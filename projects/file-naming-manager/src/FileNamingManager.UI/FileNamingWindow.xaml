<Window x:Class="FileNamingManager.UI.FileNamingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/FileNamingManager.UI;component/Assets/analyze-naming-light-32.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="File Naming Manager" />
            <TextBlock Margin="0,6,0,2" FontWeight="SemiBold" Text="Active assembly" />
            <TextBlock Text="{Binding RootAssemblyPath}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,2" FontWeight="SemiBold" Text="Project root" />
            <TextBlock Text="{Binding ProjectRootPath}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ProjectNumberLabel"
                       Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Project number" />
            <TextBox Grid.Row="0"
                      Grid.Column="1"
                      VerticalContentAlignment="Center"
                      Text="{Binding ProjectNumberText, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.LabeledBy="{Binding ElementName=ProjectNumberLabel}" />
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Foreground="DimGray" Text="{Binding ProjectNumberSuggestionText}" TextWrapping="Wrap" />
                <TextBlock Foreground="Red" Text="{Binding ProjectNumberError}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <CheckBox Content="Rename unnumbered files" IsChecked="{Binding RenameUnnumbered, Mode=TwoWay}" />
                <CheckBox Margin="0,6,0,0"
                          Content="Normalize malformed numbered names"
                          IsChecked="{Binding NormalizeMalformed, Mode=TwoWay}" />
                <TextBlock Margin="20,2,0,6"
                           Foreground="DimGray"
                           Text="{Binding NormalizeMalformedWarning}"
                           TextWrapping="Wrap" />
                <CheckBox Content="Set Part Number iProperty" IsChecked="{Binding SetPartNumberProperty, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,6" Orientation="Horizontal">
                <Button x:Name="SelectAllButton"
                        Padding="10,3"
                        Click="SelectAll_Click"
                        Content="Select all" />
                <Button x:Name="SelectNoneButton"
                        Margin="8,0,0,0"
                        Padding="10,3"
                        Click="SelectNone_Click"
                        Content="Select none" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           Text="Include column: untick a row to leave it out of the plan." />
            </StackPanel>

            <DataGrid Grid.Row="1"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Include" Width="60" SortMemberPath="IsIncluded">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          AutomationProperties.Name="Include this file in the plan"
                                          IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanToggle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Current name" Binding="{Binding CurrentFileName}" Width="2*" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                    <DataGridTextColumn Header="Vault" Binding="{Binding VaultState}" Width="*" />
                    <DataGridTextColumn Header="Proposed name" Binding="{Binding ProposedFileName}" Width="2*" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                    <DataGridTextColumn Header="Reasons" Binding="{Binding Reasons}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Margin="0,12,0,4" FontWeight="SemiBold" Text="Project findings" />
            <ListBox Grid.Row="3" ItemsSource="{Binding Findings}" />
        </Grid>

        <Separator Grid.Row="3" Margin="0,14,0,10" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />

            <Button Grid.Column="1"
                    Width="130"
                    Padding="8,4"
                    IsEnabled="{Binding HasVaultInstructions}"
                    Click="ExportVaultPlan_Click"
                    Content="Export Vault plan" />

            <TextBlock Grid.Column="2"
                       Margin="10,0,10,0"
                       MaxWidth="260"
                       VerticalAlignment="Center"
                       Foreground="Red"
                       Text="{Binding ApplyDisabledReason}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsApplyMode, Converter={StaticResource BoolToVisibility}}" />

            <Button Grid.Column="3"
                    Width="112"
                    Padding="10,6"
                    IsDefault="True"
                    IsEnabled="{Binding CanApply}"
                    ToolTip="{Binding ApplyDisabledReason}"
                    Click="Apply_Click"
                    Content="Apply"
                    Visibility="{Binding IsApplyMode, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
