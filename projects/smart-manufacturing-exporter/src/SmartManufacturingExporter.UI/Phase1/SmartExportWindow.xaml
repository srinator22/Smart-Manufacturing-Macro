<Window x:Class="SmartManufacturingExporter.UI.Phase1.SmartExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartManufacturingExporter.UI.Phase1"
        Title="Smart Export"
        Width="880"
        Height="560"
        MinWidth="700"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/SmartManufacturingExporter.UI;component/Assets/smart-export-32.png">
    <Grid Margin="18">
        <Grid.Resources>
            <HierarchicalDataTemplate DataType="{x:Type local:SmartExportTreeNodeViewModel}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <CheckBox Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding CanSelect}"
                              IsThreeState="True"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="DimGray" Text="{Binding DocumentKind, StringFormat='[{0}]'}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="DimGray" Text="{Binding Quantity, StringFormat='Qty {0}'}" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="DimGray"
                               Text="{Binding SourcePath}" />
                </StackPanel>
            </HierarchicalDataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Smart Export" />
            <TextBlock Margin="0,6,0,2" FontWeight="SemiBold" Text="Active assembly" />
            <TextBlock Text="{Binding RootAssemblyPath}" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock x:Name="ScopeLabel" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Export scope" />
                <ComboBox Width="180"
                          ItemsSource="{Binding ScopeOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Mode"
                          SelectedValue="{Binding SelectedScope, Mode=TwoWay}"
                          AutomationProperties.Name="Export scope"
                          AutomationProperties.LabeledBy="{Binding ElementName=ScopeLabel}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="88" Padding="8,4" Click="SelectAll_Click" Content="Select All" />
                <Button Width="88" Margin="8,0,0,0" Padding="8,4" Click="SelectNone_Click" Content="Select None" />
                <Button Width="88" Margin="8,0,0,0" Padding="8,4" Click="ExpandAll_Click" Content="Expand All" />
                <Button Width="88" Margin="8,0,0,0" Padding="8,4" Click="CollapseAll_Click" Content="Collapse All" />
            </StackPanel>
        </DockPanel>

        <TreeView Grid.Row="2" ItemsSource="{Binding RootNodes}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <Grid Grid.Row="3" Margin="0,14,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Destination" />
            <TextBox Grid.Row="0" Grid.Column="1" MinWidth="300" VerticalContentAlignment="Center" Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="2" Width="88" Margin="8,0,0,0" Padding="8,4" Click="Browse_Click" Content="Browse..." />

            <TextBlock x:Name="StepPrecisionLabel"
                       Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,12,10,0"
                       VerticalAlignment="Top"
                       FontWeight="SemiBold"
                       Text="STEP precision" />
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <ComboBox Width="150"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding StepPrecisionOptions}"
                          SelectedItem="{Binding SelectedStepPrecision, Mode=TwoWay}"
                          AutomationProperties.Name="STEP precision"
                          AutomationProperties.LabeledBy="{Binding ElementName=StepPrecisionLabel}" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="DimGray"
                           Text="{Binding StepPrecisionDescription}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1"
                    Width="112"
                    Padding="10,6"
                    IsDefault="True"
                    IsEnabled="{Binding CanExport}"
                    Click="Export_Click"
                    Content="Export STEP" />
        </Grid>
    </Grid>
</Window>
