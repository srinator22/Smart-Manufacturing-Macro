<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(ProgramFiles)\Autodesk\Inventor 2027\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
    <ApplicationManifest>SmartManufacturingExporter.AddIn.X.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(InventorInteropPath)')">
    <DefineConstants>$(DefineConstants);INVENTOR_INTEROP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartManufacturingExporter.Application\SmartManufacturingExporter.Application.csproj" />
    <ProjectReference Include="..\SmartManufacturingExporter.Infrastructure\SmartManufacturingExporter.Infrastructure.csproj" />
    <ProjectReference Include="..\SmartManufacturingExporter.InventorAdapter\SmartManufacturingExporter.InventorAdapter.csproj" />
    <ProjectReference Include="..\SmartManufacturingExporter.UI\SmartManufacturingExporter.UI.csproj" />
    <ProjectReference Include="..\..\..\..\shared\WmpRibbon\WmpRibbon.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(InventorInteropPath)')">
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <EmbeddedResource Include="..\..\assets\smart-export-16.png"
                      Link="Assets\smart-export-16.png"
                      LogicalName="SmartManufacturingExporter.AddIn.Assets.smart-export-16.png" />
    <EmbeddedResource Include="..\..\assets\smart-export-32.png"
                      Link="Assets\smart-export-32.png"
                      LogicalName="SmartManufacturingExporter.AddIn.Assets.smart-export-32.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
